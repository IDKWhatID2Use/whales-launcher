{
  "schema": "whaleslauncher.tutorial.plan/1",
  "description": "Probe plan 4: card more-menu, edit dialog, delete dialog, log drawer.",
  "exe": "F:\\WhalesLauncher\\desktop\\src\\WhalesLauncher.App\\bin\\Debug\\net10.0-windows10.0.26100.0\\win-x64\\WhalesLauncher.exe",
  "home": "F:\\Temp\\whales-tutorial-home",
  "outDir": "F:\\WhalesLauncher\\.probe\\tutorial-work\\probe",
  "sessions": [
    {
      "id": "probe-overlays",
      "route": "instances",
      "waitMs": 9000,
      "shots": [
        {
          "name": "probe-card-menu",
          "scratch": true,
          "mode": "screen",
          "steps": [
            { "Type": "uia", "Action": "invoke", "Ct": "Button", "Name": "更多操作", "Index": 0, "TimeoutMs": 4000 },
            { "Type": "wait", "Ms": 1200 },
            { "Type": "uia", "Action": "dump" }
          ]
        },
        {
          "name": "probe-edit-dialog",
          "scratch": true,
          "mode": "screen",
          "steps": [
            { "Type": "uia", "Action": "invoke", "NameLike": "编辑设置", "TimeoutMs": 4000 },
            { "Type": "wait", "Ms": 1500 },
            { "Type": "uia", "Action": "dump" }
          ]
        },
        {
          "name": "probe-delete-dialog",
          "scratch": true,
          "mode": "screen",
          "steps": [
            { "Type": "key", "Chord": "Escape" },
            { "Type": "wait", "Ms": 900 },
            { "Type": "uia", "Action": "invoke", "Ct": "Button", "Name": "更多操作", "Index": 0, "TimeoutMs": 4000 },
            { "Type": "wait", "Ms": 1200 },
            { "Type": "uia", "Action": "invoke", "NameLike": "删除实例", "TimeoutMs": 4000 },
            { "Type": "wait", "Ms": 1500 },
            { "Type": "uia", "Action": "dump" }
          ]
        },
        {
          "name": "probe-log-drawer",
          "scratch": true,
          "steps": [
            { "Type": "key", "Chord": "Escape" },
            { "Type": "wait", "Ms": 900 },
            { "Type": "key", "Chord": "Ctrl+L" },
            { "Type": "wait", "Ms": 2000 },
            { "Type": "uia", "Action": "dump" }
          ]
        }
      ]
    }
  ]
}
