{
  "schema": "whaleslauncher.tutorial.plan/1",
  "description": "Probe plan 2: dump the UIA tree of every page that still needs selectors (detail tabs, engines, settings, wizard).",
  "exe": "F:\\WhalesLauncher\\desktop\\src\\WhalesLauncher.App\\bin\\Debug\\net10.0-windows10.0.26100.0\\win-x64\\WhalesLauncher.exe",
  "home": "F:\\Temp\\whales-tutorial-home",
  "outDir": "F:\\WhalesLauncher\\.probe\\tutorial-work\\probe",
  "sessions": [
    {
      "id": "probe-detail",
      "route": "detail/tut-0001-workbench/plugins",
      "waitMs": 9000,
      "shots": [
        {
          "name": "probe-detail-plugins",
          "scratch": true,
          "steps": [
            { "Type": "uia", "Action": "dump" },
            { "Type": "uia", "Action": "info", "NameLike": "设置", "Ct": "ListItem", "TimeoutMs": 3000 },
            { "Type": "uia", "Action": "select", "Name": "设置", "Ct": "ListItem", "TimeoutMs": 3000 },
            { "Type": "wait", "Ms": 1200, "Comment": "switch to the settings tab through UIA" }
          ]
        },
        {
          "name": "probe-detail-settings",
          "scratch": true,
          "steps": [
            { "Type": "uia", "Action": "dump" }
          ]
        }
      ]
    },
    {
      "id": "probe-engines",
      "route": "engines",
      "waitMs": 9000,
      "shots": [
        {
          "name": "probe-engines",
          "scratch": true,
          "steps": [
            { "Type": "uia", "Action": "dump" }
          ]
        }
      ]
    },
    {
      "id": "probe-settings",
      "route": "settings",
      "waitMs": 9000,
      "shots": [
        {
          "name": "probe-settings",
          "scratch": true,
          "steps": [
            { "Type": "uia", "Action": "dump" }
          ]
        },
        {
          "name": "probe-settings-scrolled",
          "scratch": true,
          "steps": [
            { "Type": "wheel", "Delta": -600 },
            { "Type": "wait", "Ms": 900 },
            { "Type": "uia", "Action": "dump" }
          ]
        }
      ]
    },
    {
      "id": "probe-wizard",
      "route": "create",
      "waitMs": 9000,
      "shots": [
        {
          "name": "probe-wizard-step1",
          "scratch": true,
          "steps": [
            { "Type": "uia", "Action": "dump" },
            { "Type": "uia", "Action": "info", "NameLike": "下一步", "Ct": "Button", "TimeoutMs": 3000 }
          ]
        },
        {
          "name": "probe-wizard-step2",
          "scratch": true,
          "steps": [
            { "Type": "uia", "Action": "invoke", "NameLike": "下一步", "Ct": "Button", "TimeoutMs": 4000 },
            { "Type": "wait", "Ms": 1500 },
            { "Type": "uia", "Action": "dump" }
          ]
        }
      ]
    }
  ]
}
