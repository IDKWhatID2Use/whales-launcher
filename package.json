{
  "name": "whales-launcher",
  "version": "1.0.2",
  "private": true,
  "description": "WhalesLauncher —— DeepSeek Harness (dsh) 的实例与版本管理启动器（WinUI 3 前端 + Node 侧车业务引擎）",
  "type": "module",
  "scripts": {
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:app": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build-app.ps1",
    "build": "npm run build:bridge && npm run build:app",
    "icon": "node scripts/make-icon.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "test:core": "node --test --test-isolation=none \"tests/core/*.test.mjs\"",
    "smoke:bridge": "node scripts/audit/bridge-smoke.mjs",
    "test:ui": "node scripts/test/run-ui-tests.mjs",
    "audit:visual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit/audit-visual.ps1",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
