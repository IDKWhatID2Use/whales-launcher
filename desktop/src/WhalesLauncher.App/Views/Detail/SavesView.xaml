<?xml version="1.0" encoding="utf-8"?>
<!--
    P4 实例详情 · 存档（视觉规范 §9.5）。

    结构：页头（面包屑 + 标题）→ 错误/空态 → 工具条（workspace 筛选 + 合计）→ ListView。
    本页不做分页：规范 §9.5 明确 PagerControl 是预览版控件（§6.2 禁用），
    因此用 ListView 自身的虚拟化承载全部存档。
-->
<UserControl
    x:Class="WhalesLauncher.Views.Detail.SavesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:detail="using:WhalesLauncher.Views.Detail">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <muxc:BreadcrumbBar x:Name="Crumb" Grid.Row="0" />

        <TextBlock
            Grid.Row="1"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="存档" />

        <muxc:InfoBar
            x:Name="ErrorBar"
            Grid.Row="2"
            Severity="Error"
            IsClosable="True"
            IsOpen="False" />

        <!-- 工具条：workspace 筛选 + 合计（§9.5 Row1） -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="WorkspaceFilter"
                Grid.Column="0"
                MinWidth="200"
                AutomationProperties.Name="按工作区筛选存档"
                Header="工作区"
                SelectionChanged="OnWorkspaceChanged" />

            <TextBlock
                x:Name="SummaryText"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="共 0 个存档" />
        </Grid>

        <!-- 加载态：不确定时长且不阻断 → 工具条下缘一条 indeterminate ProgressBar（§6.6） -->
        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="4"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <Grid Grid.Row="5">
            <ListView
                x:Name="SavesList"
                ItemsSource="{x:Bind Rows, Mode=OneWay}"
                Loaded="OnLoaded"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8,12,8" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="detail:SessionRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE8B7;" />

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Id, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <!-- workspaceKey 是归属标识；完整目录放 ToolTip，避免长路径撑破行 -->
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind WorkspaceKey, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Dir, Mode=OneTime}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RelativeText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- 体积右对齐、固定宽，避免各行数字跳动 -->
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                HorizontalTextAlignment="Right"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SizeText, Mode=OneTime}" />

                            <Button
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="打开此存档目录"
                                Click="OnOpenSessionClick"
                                Content="打开"
                                Tag="{x:Bind Id, Mode=OneTime}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 整页空态（§9.5；筛选后的行内空态见下方 FilteredEmpty 覆盖层） -->
            <StackPanel
                x:Name="EmptyState"
                MaxWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="24"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                    Text="还没有存档" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="存档在实例运行后产生"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 行内空态：只是当前筛选没有结果，不是整页没数据（§9.5「空 workspace」） -->
            <TextBlock
                x:Name="FilteredEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="该工作区暂无存档"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
