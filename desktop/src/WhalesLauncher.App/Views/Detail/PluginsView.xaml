<?xml version="1.0" encoding="utf-8"?>
<!--
    P2 实例详情 · 插件（视觉规范 §9.3）。

    三块内容（内置组合包 / 本地插件 / 依赖）共用同一内容区，按 SelectorBar 选中项切 Visibility。
    选 SelectorBar 而非 TabView：规范 §6.3 明确 4 个详情页签是固定集合，
    TabView 的关闭/拖出语义会造成切页丢状态。
-->
<UserControl
    x:Class="WhalesLauncher.Views.Detail.PluginsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:detail="using:WhalesLauncher.Views.Detail">

    <UserControl.Resources>
        <!--
            安装对话框。做成 Flyout 而不是 ContentDialog：安装过程要持续显示进度与输出，
            而 ContentDialog 点主按钮即关闭，关掉后就无处呈现结果（规范 §6.4 也要求同一窗口
            同时只能开一个 ContentDialog）。

            放在 Resources 里而不是与根 Grid 平级：`UserControl.Content` 只接受**单个 UIElement**，
            而 `Flyout` 是 `FlyoutBase : DependencyObject`（不是 UIElement），
            平级摆放会触发 WMC0020「Cannot add 'Flyout' into the collection property 'Children'」。
        -->
        <Flyout x:Name="InstallFlyout" Placement="Bottom" Closed="OnInstallFlyoutClosed">
            <StackPanel Width="400" Spacing="8">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="安装本地插件" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="安装后的插件落在实例目录内，整个实例可像整合包一样搬运"
                    TextWrapping="Wrap" />

                <muxc:RadioButtons
                    x:Name="InstallKind"
                    SelectionChanged="OnInstallKindChanged">
                    <x:String>zip 压缩包</x:String>
                    <x:String>GitHub 仓库</x:String>
                    <x:String>本地文件夹</x:String>
                </muxc:RadioButtons>

                <TextBox
                    x:Name="GithubUrlBox"
                    AutomationProperties.Name="GitHub 仓库地址"
                    PlaceholderText="owner/repo 或仓库地址"
                    Visibility="Collapsed" />

                <Button
                    x:Name="PickButton"
                    AutomationProperties.Name="选择来源"
                    Click="OnPickSourceClick"
                    Content="选择 zip 文件…" />

                <ProgressBar
                    x:Name="InstallProgress"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="InstallStageText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在安装…"
                    Visibility="Collapsed" />

                <!-- 取消按钮：后端无取消通道（规范 §11 U19），禁用并 ToolTip 说明 -->
                <Button
                    x:Name="CancelInstallButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="取消安装（本版本不可用）"
                    Content="取消安装"
                    IsEnabled="False"
                    ToolTipService.ToolTip="后端暂不提供取消能力，安装会在当前步骤完成后停止。" />

                <muxc:InfoBar
                    x:Name="InstallOutcomeBar"
                    IsClosable="False"
                    IsOpen="False" />

                <!-- 安装原始输出（含 AllowBuildsError 的 pnpm/dsh 原文），可复制 -->
                <TextBox
                    x:Name="InstallOutputBox"
                    MaxHeight="160"
                    AcceptsReturn="True"
                    AutomationProperties.Name="安装原始输出"
                    FontFamily="Cascadia Mono, Consolas, monospace"
                    Header="原始输出"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    Visibility="Collapsed" />

                <Button
                    x:Name="CloseInstallButton"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="关闭安装面板"
                    Click="OnCloseInstallClick"
                    Content="关闭" />
            </StackPanel>
        </Flyout>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <muxc:BreadcrumbBar x:Name="Crumb" Grid.Row="0" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="插件" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="RefreshButton"
                    AutomationProperties.Name="刷新插件信息"
                    Click="OnRefreshClick"
                    Content="刷新" />
                <Button
                    x:Name="InstallButton"
                    AutomationProperties.Name="安装本地插件"
                    Click="OnInstallClick"
                    Content="安装本地插件"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <muxc:InfoBar
            x:Name="WarnBar"
            Grid.Row="2"
            Severity="Warning"
            IsClosable="True"
            IsOpen="False" />

        <muxc:InfoBar
            x:Name="ErrorBar"
            Grid.Row="3"
            Severity="Error"
            IsClosable="True"
            IsOpen="False" />

        <muxc:SelectorBar
            x:Name="BlockBar"
            Grid.Row="4"
            SelectionChanged="OnBlockChanged" />

        <Grid Grid.Row="5">
            <ProgressBar
                x:Name="LoadingBar"
                VerticalAlignment="Top"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <!-- 块 A：内置组合包 -->
            <Grid x:Name="BundlesBlock">
                <ListView x:Name="BundlesList" ItemsSource="{x:Bind Bundles, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,8,12,8" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="detail:BundleRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 乐观更新：切换即调后端，失败回滚（§9.3「组合包开关的乐观更新」） -->
                                <ToggleSwitch
                                    Grid.Column="0"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="启用或停用该组合包"
                                    IsOn="{x:Bind Enabled, Mode=OneWay}"
                                    Tag="{x:Bind Entry.Name, Mode=OneTime}"
                                    Toggled="OnBundleToggled" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Entry.Name, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind VersionText, Mode=OneTime}" />
                                    <TextBlock
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Entry.Description, Mode=OneTime}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Padding="8,4,8,4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Visibility="{x:Bind BuiltinBadgeVisibility, Mode=OneTime}">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="随 dsh 安装" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="BundlesEmpty"
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="24"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                        Text="没有组合包" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="该实例的 profile 未登记任何组合包"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 块 B：本地插件（home/plugins） -->
            <Grid x:Name="LocalBlock" Visibility="Collapsed">
                <!-- ItemsRepeater 不虚拟化，必须放进 ScrollView；StackLayout 负责 8 epx 间距 -->
                <ScrollView VerticalScrollBarVisibility="Auto">
                    <muxc:ItemsRepeater ItemsSource="{x:Bind LocalPlugins, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Spacing="8" />
                        </muxc:ItemsRepeater.Layout>
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="detail:LocalPluginRow">
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind VersionText, Mode=OneTime}" />
                                                <TextBlock
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind DescriptionText, Mode=OneTime}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind DescriptionVisibility, Mode=OneTime}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Top">
                                                <Button
                                                    AutomationProperties.Name="在资源管理器中打开插件根目录"
                                                    Click="OnOpenPluginFolderClick"
                                                    Content="打开插件根目录"
                                                    ToolTipService.ToolTip="用资源管理器打开实例的 home/plugins（该插件位于此目录下）"
                                                    Tag="{x:Bind Name, Mode=OneTime}" />
                                                <Button
                                                    AutomationProperties.Name="更多插件操作"
                                                    Tag="{x:Bind Name, Mode=OneTime}">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuFlyoutItem
                                                                Click="OnRemoveLocalClick"
                                                                Text="删除插件…" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="16"
                                                        Glyph="&#xE712;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 标记行：hasBundlePatch / hasClient / 启用状态 / 来源，用徽标形式 -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border
                                                Padding="8,4,8,4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind OriginText, Mode=OneTime}" />
                                            </Border>
                                            <Border
                                                Padding="8,4,8,4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind EnabledText, Mode=OneTime}" />
                                            </Border>
                                            <Border
                                                Padding="8,4,8,4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind BundlePatchText, Mode=OneTime}" />
                                            </Border>
                                            <Border
                                                Padding="8,4,8,4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ClientText, Mode=OneTime}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 账本与自检结论不一致时显式提示（契约 contracts.ts:261-267 要求） -->
                                        <muxc:InfoBar
                                            Grid.Row="2"
                                            Severity="Warning"
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="启动器账本记录已安装，但包内没有 bundle patch，未参与配置树组合。"
                                            Title="安装状态与自检结论不一致"
                                            Visibility="{x:Bind AttentionVisibility, Mode=OneTime}" />

                                        <TextBlock
                                            Grid.Row="3"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind ShortDir, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Dir, Mode=OneTime}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                </ScrollView>

                <StackPanel
                    x:Name="LocalEmpty"
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="24"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                        Text="还没有本地插件" />
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="安装本地插件"
                        Click="OnInstallClick"
                        Content="安装本地插件" />
                </StackPanel>
            </Grid>

            <!-- 块 C：依赖表（表头独立 Grid 行，与 ItemTemplate 共用同一列宽） -->
            <Grid x:Name="DepsBlock" Visibility="Collapsed" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="12,0,12,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="名称" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="规格 spec" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="版本" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="状态" />
                </Grid>

                <ListView
                    x:Name="DepsList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Dependencies, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,8,12,8" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="detail:PluginRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <!-- spec 原文，绝不用版本号代替（契约 contracts.ts:188-194） -->
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas, monospace"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SpecText, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind SpecText, Mode=OneTime}" />
                                    <Border
                                        Padding="8,4,8,4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Visibility="{x:Bind ExternalBadgeVisibility, Mode=OneTime}">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="外部引用" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind VersionText, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusText, Mode=OneTime}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="DepsEmpty"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="24"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                        Text="没有额外依赖" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="该实例只使用随 dsh 提供的组合包"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

