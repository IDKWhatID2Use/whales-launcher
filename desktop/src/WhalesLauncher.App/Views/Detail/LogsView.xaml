<?xml version="1.0" encoding="utf-8"?>
<!--
    P5 实例详情 · 日志（视觉规范 §9.6）。

    本页只是「工具条 + 状态条 + 复用控件」的组装：真正的日志渲染在
    LogView（同目录）里，那份控件同时被外壳右侧日志抽屉复用（§9.1）。
    事件订阅放在本页而不是控件里 —— 订阅若写在控件里，两处宿主会各订阅一次，
    同一行日志被渲染两遍。
-->
<UserControl
    x:Class="WhalesLauncher.Views.Detail.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:detail="using:WhalesLauncher.Views.Detail">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <muxc:BreadcrumbBar
                x:Name="Crumb"
                Grid.Column="0"
                ItemClicked="OnCrumbItemClicked" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="OpenLogsFolderButton"
                    AutomationProperties.Name="在资源管理器中打开日志目录"
                    Click="OnOpenLogsFolderClick"
                    Content="打开日志目录" />
                <Button
                    x:Name="CopyAllButton"
                    AutomationProperties.Name="复制当前显示的全部日志"
                    Click="OnCopyAllClick"
                    Content="复制全部" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="日志" />

        <!-- 页级错误：任何后端调用失败都在这里露出 result.Error 原文（规范 §9.0「错误」） -->
        <muxc:InfoBar
            x:Name="ErrorBar"
            Grid.Row="2"
            Severity="Error"
            IsClosable="True"
            IsOpen="False" />

        <!-- Row1 工具条：流过滤 / 关键字 / 跟随 / 清空（§9.6 布局骨架） -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <muxc:SelectorBar
                x:Name="StreamBar"
                Grid.Column="0"
                SelectionChanged="OnStreamFilterChanged" />

            <TextBox
                x:Name="KeywordBox"
                Grid.Column="1"
                Width="200"
                AutomationProperties.Name="日志关键字过滤"
                PlaceholderText="关键字过滤"
                TextChanged="OnKeywordChanged" />

            <!--
                注意：这里**不写** IsOn="True"。
                WinUI 在 LoadComponent 解析阶段给尚未挂上事件处理器的 ToggleSwitch 赋字面量
                IsOn="True" 会在 ApplyTemplate 里抛异常，被包装成
                XamlParseException("Failed to assign to property 'ToggleSwitch.IsOn'")，
                且异常发生在 LoadComponent 内部 → 整个 UserControl 构造失败 → 导航到详情页时进程崩溃
                （0xc000027b / 0x800F1000）。初始值改在构造函数里赋（见 LogsView.xaml.cs），
                行为相同但走的是设置器而非 XAML 赋值路径。
            -->
            <ToggleSwitch
                x:Name="FollowSwitch"
                Grid.Column="3"
                MinWidth="0"
                AutomationProperties.Name="跟随日志底部"
                Header="跟随"
                Toggled="OnFollowToggled" />

            <Button
                x:Name="ClearButton"
                Grid.Column="4"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="清空当前显示的日志"
                Click="OnClearClick"
                Content="清空" />
        </Grid>

        <!-- Row2 日志本体（复用控件；LogView 自带空态 / 截断提示 / 回到底部） -->
        <detail:LogView x:Name="Logs" Grid.Row="4" />

        <!-- Row3 状态条（§9.6）：Caption + 三级文字色 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="CountText"
                Grid.Column="0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="显示 0 / 共 0 行" />

            <TextBlock
                x:Name="TruncateText"
                Grid.Column="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="较早日志已截断（已丢弃 0 行）"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
