<?xml version="1.0" encoding="utf-8"?>
<!--
    P6 引擎版本管理（视觉规范 §9.7）。

    骨架说明：§9.0 的通用骨架是「页头 → InfoBar 区 → 内容区 →（可选）状态条」，
    §9.7 又要求「页签行 + 安装日志 Expander」，两者合并后本页落成 5 行 Grid：
      Row0 页头 / Row1 InfoBar 区 / Row2 页签 + Node 说明 / Row3 内容 / Row4 安装日志。

    内容区**不外包 ScrollViewer**：§9.0 明确规定 P1/P5/P6 的内容区自带虚拟化滚动，
    两个 ListView 直接挂在 Grid 行上（§2.4 禁止把虚拟化列表放进 StackPanel）。

    表格化呈现用「ListView + 行内 Grid DataTemplate + 独立表头 Grid 行」，
    因为 TableView 是 [MUX_PREVIEW] 预览控件（§6.2 ⛔ 清单）。
-->
<Page
    x:Class="WhalesLauncher.Views.EnginesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhalesLauncher.Controls"
    xmlns:local="using:WhalesLauncher.Views">

    <Page.Resources>
        <!--
            行容器样式：ListViewItem 默认带内边距与最小高度，会让行内 Grid 与"独立表头 Grid 行"错位。
            清零内边距 + 横向拉伸后，行 Grid 与表头 Grid 用同一组列宽就能真正对齐。
            另外关掉容器焦点（IsTabStop=False）：这两张表用 SelectionMode=None，焦点应直接落在行内按钮上。
        -->
        <Style x:Key="EngineRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!-- 日志行容器：同上，且日志行不需要选中态 -->
        <Style x:Key="LogRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!--
            已安装版本行。列宽必须与下方 InstalledHeader 的列宽逐列一致（表头是独立 Grid 行）。
            §9.7 ItemTemplate 规定：version / 目录 / 体积（右对齐）/ 占用 / 移除按钮。
        -->
        <DataTemplate x:Key="InstalledEngineTemplate" x:DataType="local:EngineInstalledRow">
            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                    Text="{x:Bind Version}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Version}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind DirDisplay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Dir}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind SizeText}"
                    ToolTipService.ToolTip="{x:Bind SizeTooltip}" />

                <!--
                    占用情况分两条 TextBlock 而不是在 code-behind 里改 Foreground：
                    颜色必须来自 {ThemeResource}，换主题时框架才会重新求值（§7.4 禁止在 code-behind 里改颜色）。
                    >0 时用 SystemFillColorCautionBrush（§9.7 关键规格）。
                -->
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind FreeText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind FreeVisibility}"
                    ToolTipService.ToolTip="{x:Bind FreeText}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Text="{x:Bind UsedText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind UsedVisibility}"
                    ToolTipService.ToolTip="{x:Bind UsedTooltip}" />

                <!-- 操作列：ToolTip 挂在容器 Grid 上，这样按钮被禁用时悬停仍能看到"为什么不能移除" -->
                <Grid Grid.Column="4" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind RemoveTooltip, Mode=OneWay}">
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OnRemoveClick"
                        Content="移除"
                        IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                        Tag="{x:Bind}"
                        Visibility="{x:Bind RemoveButtonVisibility, Mode=OneWay}" />

                    <!-- 该行正在移除：内联忙碌态（§6.6 按钮内联忙碌，ProgressRing 20×20） -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind BusyVisibility, Mode=OneWay}">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="移除中" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!--
            可安装版本行（§9.7：版本号 + 安装按钮；已安装的行显示"已安装"徽标且按钮禁用）。
        -->
        <DataTemplate x:Key="AvailableEngineTemplate" x:DataType="local:EngineAvailableRow">
            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                        Text="{x:Bind Version}" />
                    <Border
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind InstalledBadgeVisibility, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="已安装" />
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind InstallTooltip, Mode=OneWay}">
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OnInstallClick"
                        Content="安装"
                        IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                        Tag="{x:Bind}"
                        Visibility="{x:Bind InstallButtonVisibility, Mode=OneWay}" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind BusyVisibility, Mode=OneWay}">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="安装中" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!--
            安装日志行（§9.7「与 P5 同一控件、独立缓冲」；此控件由本页自建，见回复中的登记）。
            结构照 §9.6：色条（形/色双通道）+ 流标签 + 时间戳 + 正文（等宽字族）。
            system 流用"· "前缀区分（§9.6：TextBlock 没有斜体字阶，不能靠斜体表达）。
        -->
        <DataTemplate x:Key="InstallLogTemplate" x:DataType="local:EngineLogLine">
            <Grid Padding="8,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 色条宽 2：§9.6 显式规定该值（细则优先于 §2.1 的 4 epx 通则，同 §5 的 1px 描边） -->
                <Rectangle
                    Grid.Column="0"
                    Width="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="{x:Bind StdoutVisibility}" />
                <Rectangle
                    Grid.Column="0"
                    Width="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Fill="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind StderrVisibility}" />
                <Rectangle
                    Grid.Column="0"
                    Width="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Fill="{ThemeResource SystemFillColorAttentionBrush}"
                    Visibility="{x:Bind SystemVisibility}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind StreamLabel}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind TimeText}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Top"
                    FontFamily="Cascadia Mono,Consolas"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind StdoutVisibility}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Top"
                    FontFamily="Cascadia Mono,Consolas"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind StderrVisibility}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Top"
                    FontFamily="Cascadia Mono,Consolas"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SystemText}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind SystemVisibility}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="24"
        Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row0：页头（§9.0 强制用 Controls/PageHeader）+ 右侧主操作区 -->
        <controls:PageHeader
            x:Name="Header"
            Grid.Row="0"
            Margin="0,0,0,16"
            Title="引擎版本"
            Description="管理本机 dsh 引擎版本：安装新版本、查看被哪些实例占用、移除不再需要的版本。">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Node 运行时状态小徽标（§9.7 Row0）；两枚图标用 Visibility 切换而不是改颜色，保证换主题时生效 -->
                    <Border
                        x:Name="NodeBadge"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="NodeBadgeOkIcon"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="Collapsed" />
                            <FontIcon
                                x:Name="NodeBadgeFailIcon"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE783;"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="NodeBadgeText"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="检测中…" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="RefreshAvailableButton"
                        AutomationProperties.Name="刷新可用版本"
                        Click="OnRefreshAvailableClick"
                        ToolTipService.ToolTip="重新从 npm registry 查询可安装的 dsh 版本">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新可用版本" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Row1：InfoBar 区（§9.0）。默认全折叠，不占位 -->
        <StackPanel x:Name="InfoBarHost" Grid.Row="1">
            <InfoBar
                x:Name="ErrorInfoBar"
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="操作失败"
                Visibility="Collapsed">
                <InfoBar.Message>可以复制下面的原文用于排查。</InfoBar.Message>
                <InfoBar.Content>
                    <TextBlock x:Name="ErrorDetailText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                x:Name="NodeWarningInfoBar"
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="False"
                Severity="Warning"
                Title="Node 运行时不可用"
                Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.Name="去全局设置修复 Node 运行时"
                        Click="OnGoToSettingsClick"
                        Content="去全局设置修复" />
                </InfoBar.ActionButton>
                <InfoBar.Message>引擎安装依赖 npm 与 Node.js，修好后本页会自动可用。</InfoBar.Message>
                <InfoBar.Content>
                    <TextBlock x:Name="NodeWarningText" TextWrapping="Wrap" />
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                x:Name="AvailableWarningInfoBar"
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="False"
                Severity="Warning"
                Title="无法获取可安装版本"
                Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.Name="重试查询可用版本"
                        Click="OnRefreshAvailableClick"
                        Content="重试" />
                </InfoBar.ActionButton>
                <InfoBar.Message>这一步依赖 npm 与 registry 网络，修好后点右侧「重试」。</InfoBar.Message>
                <InfoBar.Content>
                    <TextBlock x:Name="AvailableWarningText" TextWrapping="Wrap" />
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <!-- Row2：页签（§9.7 Row1）+ 右侧"当前生效的 Node"说明 -->
        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SelectorBar
                x:Name="ViewSelector"
                AutomationProperties.Name="引擎版本视图切换"
                SelectionChanged="OnViewSelectionChanged">
                <SelectorBarItem x:Name="InstalledTab" IsSelected="True" Text="已安装" />
                <SelectorBarItem x:Name="AvailableTab" Text="可安装" />
            </SelectorBar>

            <TextBlock
                x:Name="NodeCaption"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="当前生效的 Node：检测中…"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Row3：内容区（两个视图按页签切换；各自顶部一条不定量 ProgressBar，不阻塞对方） -->
        <Grid Grid.Row="3">
            <Grid x:Name="InstalledView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressBar
                    x:Name="InstalledProgressBar"
                    Grid.Row="0"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <!-- 表头：独立 Grid 行，列宽与 InstalledEngineTemplate 逐列一致（§6.2 的 TableView 替代方案） -->
                <Grid
                    x:Name="InstalledHeader"
                    Grid.Row="1"
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    ColumnSpacing="12"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="版本" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="引擎目录" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="体积" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="占用" />
                    <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="InstalledList"
                        ItemContainerStyle="{StaticResource EngineRowContainerStyle}"
                        ItemTemplate="{StaticResource InstalledEngineTemplate}"
                        ItemsSource="{x:Bind InstalledRows}"
                        SelectionMode="None" />

                    <!-- 首屏加载：居中 ProgressRing（§9.0；Height/Width 成对且 ≥ 20） -->
                    <StackPanel
                        x:Name="InstalledFirstLoad"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            IsActive="True" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正在读取已安装的引擎版本…" />
                    </StackPanel>

                    <!-- 空态（§6.6 官方无 EmptyState 控件 → 自定方案：FontIcon + 标题 + 说明 + 主操作） -->
                    <StackPanel
                        x:Name="InstalledEmpty"
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="InstalledEmptyIcon"
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE896;" />
                        <TextBlock
                            x:Name="InstalledEmptyTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                            Text="还没有安装任何引擎版本"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="InstalledEmptyDesc"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="InstalledEmptyInstallButton"
                                Click="OnInstallLatestClick"
                                Content="安装最新版"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="InstalledEmptyRetryButton"
                                Click="OnRefreshInstalledClick"
                                Content="重试"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="AvailableView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressBar
                    x:Name="AvailableProgressBar"
                    Grid.Row="0"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <Grid
                    x:Name="AvailableHeader"
                    Grid.Row="1"
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    ColumnSpacing="12"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="版本" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="AvailableList"
                        ItemContainerStyle="{StaticResource EngineRowContainerStyle}"
                        ItemTemplate="{StaticResource AvailableEngineTemplate}"
                        ItemsSource="{x:Bind AvailableRows}"
                        SelectionMode="None" />

                    <StackPanel
                        x:Name="AvailableFirstLoad"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            IsActive="True" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正在向 npm registry 查询可安装版本…" />
                    </StackPanel>

                    <StackPanel
                        x:Name="AvailableEmpty"
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="AvailableEmptyIcon"
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            x:Name="AvailableEmptyTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                            Text="无法获取可用版本"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="AvailableEmptyDesc"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="AvailableEmptyRetryButton"
                            HorizontalAlignment="Center"
                            Click="OnRefreshAvailableClick"
                            Content="重试" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row4：安装日志（§9.7 Row3）。安装开始时自动展开：IsExpanded 由 code-behind 置位 -->
        <Expander
            x:Name="InstallLogExpander"
            Grid.Row="4"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="安装日志" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="LogHeaderStatus"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander.Header>

            <Grid Padding="0,8,0,0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 日志工具条放在 Expander 内容里（而不是 Header 里）：Header 本质是 ToggleButton，放按钮会与展开/折叠抢点击 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CopyLogButton"
                        AutomationProperties.Name="复制全部安装日志"
                        Click="OnCopyLogClick"
                        Content="复制全部"
                        IsEnabled="False"
                        ToolTipService.ToolTip="把整段安装日志复制到剪贴板（错误原文可直接粘贴给别人）" />
                    <Button
                        x:Name="ClearLogButton"
                        AutomationProperties.Name="清空安装日志"
                        Click="OnClearLogClick"
                        Content="清空"
                        IsEnabled="False" />
                    <TextBlock
                        x:Name="LogLineCountText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="暂无日志" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- MinHeight 而非 Height：§12 要求固定高容器改用 MinHeight，文本缩放 150% 时才不会裁切 -->
                    <ListView
                        x:Name="InstallLogList"
                        MinHeight="200"
                        ItemContainerStyle="{StaticResource LogRowContainerStyle}"
                        ItemTemplate="{StaticResource InstallLogTemplate}"
                        ItemsSource="{x:Bind LogLines}"
                        Loaded="OnLogListLoaded"
                        SelectionMode="None" />

                    <!--
                        安装进行中的不定量进度指示（§9.7 规定放在日志右侧）。
                        偏离说明：§9.7 原文写的是「ProgressBar（indeterminate）」，但 **WinUI 3 的
                        Microsoft.UI.Xaml.Controls.ProgressBar 没有 Orientation 属性**（只有横向形态，
                        纵向/WPF 语义不存在），因此改用 §6.6 明确列出的另一种官方进度控件 ProgressRing，
                        并成对设置 24×24、IsActive=True（§12 自检清单要求）。
                    -->
                    <StackPanel
                        x:Name="InstallProgressPanel"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <ProgressRing Width="24" Height="24" IsActive="True" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="安装中" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Expander>
    </Grid>
</Page>
