<?xml version="1.0" encoding="utf-8"?>
<!--
    P2–P5 的宿主：实例详情外壳 + 4 个标签页（视觉规范 §9.0 通用骨架 + §6.3 页签选型）。

    页签用 SelectorBar 而不是 TabView：规范 §6.3 明确本项目**不使用** TabView ——
    4 个详情页签是固定集合，TabView 的关闭/拖出语义会造成数据丢失风险（切页即丢编辑态）。
    这里的 4 个子视图因此常驻可视树、只切 Visibility，滚动位置与编辑态都得以保留。
-->
<Page
    x:Class="WhalesLauncher.Views.InstanceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:WhalesLauncher.Controls"
    xmlns:detail="using:WhalesLauncher.Views.Detail">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Left"
            Modifiers="Menu"
            Invoked="OnBackAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot" Padding="24" RowSpacing="8" SizeChanged="OnPageRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row0：页头（统一控件，规范 §9.0 硬性要求） -->
        <controls:PageHeader x:Name="Header" Grid.Row="0">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="BackButton"
                        AutomationProperties.Name="返回实例列表"
                        Click="OnBackClick"
                        Content="返回" />
                    <Button
                        x:Name="OpenFolderButton"
                        AutomationProperties.Name="在资源管理器中打开实例目录"
                        Click="OnOpenFolderClick"
                        Content="打开文件夹" />
                    <Button
                        x:Name="OpenUiButton"
                        AutomationProperties.Name="在浏览器中打开实例界面"
                        Click="OnOpenUiClick"
                        Content="打开界面"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="PrimaryActionButton"
                        AutomationProperties.Name="启动或停止实例"
                        Click="OnPrimaryActionClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <muxc:ProgressRing
                                x:Name="ActionRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock x:Name="PrimaryActionText" Text="启动" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Row1：状态提示区（降级 / 错误 / 崩溃原因） -->
        <StackPanel Grid.Row="1" Spacing="8">
            <muxc:InfoBar
                x:Name="ProblemBar"
                Severity="Warning"
                IsClosable="False"
                IsOpen="False" />

            <!--
                崩溃原因条：整段 lastError 放在**可滚动的定高容器**里。

                为什么不塞进页头的一行说明（旧做法）：实例崩溃时 core 给出的 lastError
                是"一行提示 + stderr 原文"，KREA2 那次是近千字符的单行。页头说明是
                `TextWrapping=Wrap` 的 TextBlock，于是页头被撑成十几行 —— 右列的
                「返回 / 打开文件夹 / 启动」按钮被顶到奇怪的位置（用户反馈"按钮位置不美观"），
                而详情页根 Grid **自身没有 ScrollViewer**，被挤扁的日志区连滚都滚不到
                （用户反馈"崩溃页面日志无法滚动"）。
                现在的做法：页头只留状态/端口/地址，崩溃原文进这里，限高 160 且可滚动、
                可选中复制，另给一个「查看日志」直接跳到日志页签。
            -->
            <muxc:InfoBar
                x:Name="CrashBar"
                Severity="Error"
                IsClosable="False"
                IsOpen="False"
                Title="上次启动异常退出">
                <muxc:InfoBar.ActionButton>
                    <Button
                        x:Name="ViewCrashLogButton"
                        AutomationProperties.Name="查看崩溃日志"
                        Click="OnViewCrashLogClick"
                        Content="查看日志" />
                </muxc:InfoBar.ActionButton>
                <muxc:InfoBar.Content>
                    <ScrollViewer
                        MaxHeight="160"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,16,0"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="CrashText"
                            FontFamily="Cascadia Mono, Consolas, monospace"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </muxc:InfoBar.Content>
            </muxc:InfoBar>

            <muxc:InfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>

        <!-- Row2：页签（固定 4 项） -->
        <muxc:SelectorBar
            x:Name="TabBar"
            Grid.Row="2"
            SelectionChanged="OnTabChanged" />

        <!-- Row3：内容区 -->
        <Grid Grid.Row="3">
            <Grid x:Name="TabHost" />

            <!-- 实例不存在（被外部删除）时的空态：不能白屏（规范 §6.6 自绘空态块） -->
            <StackPanel
                x:Name="MissingState"
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="32"
                    Glyph="&#xE783;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                    Text="实例不存在" />
                <TextBlock
                    x:Name="MissingText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="刷新实例列表"
                        Click="OnRetryMissingClick"
                        Content="刷新列表" />
                    <Button
                        AutomationProperties.Name="返回实例列表"
                        Click="OnBackClick"
                        Content="返回实例列表"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Row4：状态条（规范 §9.0 可选 Row3） -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
