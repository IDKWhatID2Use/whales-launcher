<?xml version="1.0" encoding="utf-8"?>
<!--
    「关于」页（左栏底部固定项的落点；交接文档 §2.2 方案 A）。

    为什么是独立页面而不是弹对话框：左栏底部的项在 NavigationView 里**一定是可选中项**。
    若点它只弹一个对话框，会留下"弹完框还高亮着"的错误语义；做成路由页则选中态本身
    就是正确表达（而且 `Alt+←`、深链 `about` 都自然成立）。

    内容全部来自**已有**的状态与通道，不为凑内容发明字段（交接文档 §5.4）：
      · 启动器版本   ← app:version（AppState.AppVersion）
      · 界面框架     ← 运行中程序集的版本（Microsoft.WinUI）
      · Node 运行时  ← launcher:detectNode 的结论（AppState.NodeRuntime，未探测过时如实说"未探测"）
      · dsh 引擎     ← engine:list（AppState.Engines）
      · 存储位置     ← launcher:getConfig（界面只读展示，**不自行拼接路径**）
-->
<Page
    x:Class="WhalesLauncher.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhalesLauncher.Controls">

    <Page.Resources>
        <Style x:Key="AboutSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="AboutLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="AboutValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
        <Style x:Key="AboutNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row0：页头（统一控件，规范 §9.0 硬性要求） -->
        <controls:PageHeader
            Grid.Row="0"
            Title="关于"
            Description="WhalesLauncher —— 让每个 dsh 实例各跑各的桌面启动器。" />

        <!-- Row1：内容区 -->
        <ScrollView
            Grid.Row="1"
            Margin="0,16,0,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1000"
                HorizontalAlignment="Left"
                Spacing="12">

                <!-- 版本信息 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="版本信息" />

                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource AboutLabelStyle}"
                                Text="启动器版本" />
                            <TextBlock
                                x:Name="LauncherVersionText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource AboutValueStyle}"
                                Text="—"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource AboutLabelStyle}"
                                Text="界面框架" />
                            <TextBlock
                                x:Name="UiFrameworkText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource AboutValueStyle}"
                                Text="—"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource AboutLabelStyle}"
                                Text="Node 运行时" />
                            <TextBlock
                                x:Name="NodeRuntimeText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource AboutValueStyle}"
                                Text="—"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource AboutLabelStyle}"
                                Text="dsh 引擎" />
                            <TextBlock
                                x:Name="EnginesText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource AboutValueStyle}"
                                Text="—"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 存储位置 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="存储位置" />

                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource AboutLabelStyle}"
                                Text="启动器根目录" />
                            <TextBlock
                                x:Name="RootDirText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource AboutValueStyle}"
                                Text="—"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource AboutLabelStyle}"
                                Text="主 home" />
                            <TextBlock
                                x:Name="PrimaryHomeText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource AboutValueStyle}"
                                Text="—"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource AboutNoteStyle}"
                                Text="实例、引擎、日志、缓存与共享资源都在根目录下；主 home 是「继承主 home」凭证策略的读取源。"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 许可与文档 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="许可与文档" />
                        <TextBlock
                            Style="{StaticResource AboutNoteStyle}"
                            Text="WhalesLauncher 采用 Polyform Noncommercial License 1.0.0：非商业用途可免费使用、修改与分发，未经授权不得用于商业用途。许可全文与必带的 Required Notice 见仓库根目录的 LICENSE（该许可证不是 OSI 认证的开源许可证）。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource AboutNoteStyle}"
                            Text="「dsh 接口勘察文档」「总体设计方案」等文档入口在标题栏的应用菜单 → 帮助里；这里不重复维护第二份入口定义。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
