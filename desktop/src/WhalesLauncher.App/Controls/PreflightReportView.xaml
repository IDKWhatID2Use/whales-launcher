<?xml version="1.0" encoding="utf-8"?>
<!--
    环境自检报告视图 —— 首次启动的报告对话框与「全局设置 → 环境自检」共用同一份呈现。

    为什么做成控件而不是各写一份（约定 §7「跨页面复用控件」）：
      · 首次启动要弹一次报告，设置页要就地展示报告 —— 两处的信息层级必须一致，
        否则用户会看到"设置页说缺引擎、首启弹窗说没问题"这类自相矛盾的结论；
      · 逐项行的构造逻辑（图标 + 状态字 + 摘要 + 建议）只写一遍。

    骨架固定、行由 code-behind 按报告数据构造（与 SettingsPage 的 Node 候选行同一手法）：
    XAML 负责样式与分组，C# 负责数据驱动的排版 —— 避免用 ItemsControl + 复杂模板去拟合
    "每项结构相同但可选块不同"的布局。

    ⚠️ 状态一律走三通道：颜色 + 图标（SymbolIcon）+ 文字（状态名），
    不靠颜色单一通道表达（视觉规范 §8.2）。
-->
<UserControl
    x:Class="WhalesLauncher.Controls.PreflightReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PreflightConclusionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="PreflightRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="PreflightRowBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
        <Style x:Key="PreflightRowMetaStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}" />
        <Style x:Key="PreflightRowMetaTertiaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <!-- 徽标三态：成功 / 警告 / 失败。都用内置状态色，不自建颜色（规范 §1.3）。 -->
        <Style x:Key="PreflightBadgeOkStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="PreflightBadgeWarnStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="PreflightBadgeBadStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <!-- 一句话结论 -->
        <TextBlock
            x:Name="ConclusionText"
            Style="{StaticResource PreflightConclusionStyle}"
            TextWrapping="Wrap"
            Text="尚未运行环境自检。" />

        <!-- 未能运行时的原因（成功时为收起状态） -->
        <InfoBar
            x:Name="FailureBar"
            IsOpen="False"
            IsClosable="False"
            Severity="Error"
            Title="环境自检未能完成" />

        <!-- 汇总行：通过 / 已修复 / 待处理 的计数 -->
        <TextBlock
            x:Name="CountersText"
            Style="{StaticResource PreflightRowMetaTertiaryStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- 逐项结论（由 code-behind 填充） -->
        <StackPanel x:Name="CheckList" Spacing="12" />

        <TextBlock
            x:Name="FooterText"
            Style="{StaticResource PreflightRowMetaTertiaryStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
