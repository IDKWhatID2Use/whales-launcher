<?xml version="1.0" encoding="utf-8"?>
<!--
    应用外壳（视觉规范 §9.1）。

    结构（对应规范 §9.1 的布局骨架）：
      Row0 [Auto] 官方 TitleBar：图标 + 标题 + 副标题（当前页名）
                  ├─ LeftHeader  = MenuBar（菜单树来自后端 app:menu，界面不自己定义菜单）
                  └─ RightHeader = 「运行日志」ToggleButton（带未读错误 InfoBadge）+ 主题切换 Button
      Row1 [*]    SplitView（PanePlacement=Right、Overlay、OpenPaneLength=480）= 运行日志抽屉
                  └─ Content = NavigationView（左功能栏 + 内容 Frame）
      顶层        ToastHost（浮层宿主，§9.10.2；容器不拦截点击）

    左栏是**纯功能导航**（实例 / 引擎版本管理 / 全局设置，底部固定「关于」），
    在这里**静态声明**，不再走 MenuItemsSource + MenuItemTemplate：
      · 实例列表只保留在「实例」页内 —— 同一批数据不再在屏幕上出现两次（用户指出的功能重复）；
      · 静态项不重建集合，因此"ItemsSource 被替换后框架自动选中第一项"这个坑
        连同对抗它的 RebuildRail() 一起消失（它在旧实现里会覆盖深链建立的详情路由）；
      · 项上必须写 AutomationProperties.Name —— UI 自动化按名字定位它，
        这同时修掉了旧方案里左栏项的 UIA Name 是 CLR 类型名（WhalesLauncher.Shell.RailEntry）的缺陷。

    历史坑（交接文档 §6.3）：NavigationView 会把 MenuItemTemplate 也套到"自容器项"
    （NavigationViewItem / NavigationViewItemSeparator）上，导致模板里的 x:Bind 全部失败、
    画出"空头像框 + 空警示图标 + 假『新建实例』"的垃圾行。本文件已不使用 MenuItemTemplate，
    这个坑不会再现；将来若要给左栏加自定义行，请另想办法，不要恢复 MenuItemTemplate
    配数据对象的组合。

    选中态由框架自带的样式给出（背景 + 左侧 3 px 强调色指示条 + 字重），
    **不要**给选中项的图标上强调色 —— 深色主题下只有那一枚图标会变成亮青色、与主题不搭
    （用户明确指出的两点之一，交接文档 §6.4）。
-->
<Window
    x:Class="WhalesLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:WhalesLauncher.Controls"
    xmlns:detail="using:WhalesLauncher.Views.Detail">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mica 不可用时的实色兜底层（规范 §3.3 的降级语义），默认折叠，由 MainWindow 探测后决定 -->
        <Border
            x:Name="BackdropFallback"
            Grid.RowSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed" />

        <muxc:TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="WhalesLauncher"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            BackRequested="OnBackRequested">
            <muxc:TitleBar.IconSource>
                <!-- 规范 §9.1 要求鲸鱼图标；项目没有位图资产，用系统 emoji 字体渲染 🐋（不引入外部文件）。
                     注意：Glyph 里**不能**写成两个分开的数字字符引用（&#xD83D;&#xDC0B;）——
                     XML 解析器会把它们当成两个孤立代理项并报 WMC9997「无效的字符」；
                     直接写字面 emoji 或 &#x1F40B; 都可以。 -->
                <FontIconSource FontFamily="Segoe UI Emoji" Glyph="🐋" />
            </muxc:TitleBar.IconSource>

            <!-- 应用菜单：结构由后端 app:menu 动态构造（契约：渲染层只是它的视图） -->
            <muxc:TitleBar.LeftHeader>
                <muxc:MenuBar x:Name="AppMenuBar" VerticalAlignment="Center" />
            </muxc:TitleBar.LeftHeader>

            <muxc:TitleBar.RightHeader>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleButton
                        x:Name="LogToggle"
                        Padding="8,4"
                        AutomationProperties.Name="运行日志"
                        ToolTipService.ToolTip="打开或关闭运行日志抽屉（Ctrl+L）">
                        <ToggleButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="L"
                                Invoked="OnLogAcceleratorInvoked"
                                Modifiers="Control" />
                        </ToggleButton.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Document" />
                            <TextBlock VerticalAlignment="Center" Text="运行日志" />
                            <muxc:InfoBadge
                                x:Name="LogErrorBadge"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="运行日志未读错误数"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ToggleButton>

                    <Button
                        x:Name="ThemeButton"
                        Padding="8,4"
                        Click="OnThemeButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- E706 = Brightness（外观），深浅两套主题下语义一致 -->
                            <FontIcon FontSize="16" Glyph="&#xE706;" />
                            <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" Text="主题" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </muxc:TitleBar.RightHeader>
        </muxc:TitleBar>

        <muxc:SplitView
            x:Name="LogDrawer"
            Grid.Row="1"
            DisplayMode="Overlay"
            IsPaneOpen="False"
            OpenPaneLength="480"
            PanePlacement="Right">
            <muxc:SplitView.Pane>
                <Grid x:Name="LogDrawerPane" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row0 抽屉标题 + 关闭 -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,16,16,8"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="运行日志" />
                        <Button
                            Grid.Column="1"
                            Click="OnCloseLogDrawerClick"
                            AutomationProperties.Name="关闭日志抽屉"
                            ToolTipService.ToolTip="关闭日志抽屉">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <!-- Row1 来源选择 + 跟随（480 宽放不下一行四个控件，拆两行避免文本放大时被裁） -->
                    <Grid
                        Grid.Row="1"
                        Padding="16,0,16,8"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="LogSourceBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="日志来源"
                            ToolTipService.ToolTip="选择日志来源：全部实例或某个实例" />
                        <ToggleButton
                            x:Name="LogFollowToggle"
                            Grid.Column="1"
                            IsChecked="True"
                            AutomationProperties.Name="跟随最新日志"
                            ToolTipService.ToolTip="打开时自动滚动到最新一行；向上滚动会暂停跟随">
                            <TextBlock Text="跟随" />
                        </ToggleButton>
                    </Grid>

                    <!-- Row2 打开日志目录 / 复制全部 -->
                    <StackPanel
                        Grid.Row="2"
                        Padding="16,0,16,8"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="OpenLogFolderButton"
                            AutomationProperties.Name="打开日志目录">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock VerticalAlignment="Center" Text="打开日志目录" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CopyAllButton"
                            AutomationProperties.Name="复制全部日志">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock VerticalAlignment="Center" Text="复制全部" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row3 日志内容：复用 P5 的 LogView（§9.1 明确要求复用），订阅由外壳负责 -->
                    <detail:LogView
                        x:Name="LogSurface"
                        Grid.Row="3"
                        Margin="8,0,8,0" />

                    <!-- Row4 状态条 -->
                    <TextBlock
                        x:Name="LogCountText"
                        Grid.Row="4"
                        Margin="16,8,16,16"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </muxc:SplitView.Pane>

            <muxc:NavigationView
                x:Name="Nav"
                AlwaysShowHeader="False"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                PaneDisplayMode="Auto"
                SelectionChanged="OnNavSelectionChanged">

                <!--
                    左栏 = 功能列表（静态声明）。

                    每项的 Tag 就是路由键，由 code-behind 的 OnNavSelectionChanged 分发；
                    **Tag 的字面值必须与 Services/NavigationService.cs 的 RouteKeys 保持一致**
                    （XAML 引用不到 C# 常量，这是唯一的重复点，改路由键时两处一起改）。

                    图标是 Segoe Fluent Icons 字形，不引入 SVG 资产；颜色一律跟随框架主题
                    （FontIcon 默认用主文字色），不要写死 hex。
                -->
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem
                        x:Name="NavInstances"
                        AutomationProperties.Name="实例"
                        Content="实例"
                        Tag="instances">
                        <muxc:NavigationViewItem.Icon>
                            <!-- E8FD = List（实例列表） -->
                            <FontIcon Glyph="&#xE8FD;" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>

                    <muxc:NavigationViewItem
                        x:Name="NavEngines"
                        AutomationProperties.Name="引擎版本管理"
                        Content="引擎版本管理"
                        Tag="engines">
                        <muxc:NavigationViewItem.Icon>
                            <!-- E71D = AllApps：与旧左栏底部入口用的字形一致，避免观感回归 -->
                            <FontIcon Glyph="&#xE71D;" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>

                    <muxc:NavigationViewItem
                        x:Name="NavSettings"
                        AutomationProperties.Name="全局设置"
                        Content="全局设置"
                        Tag="settings">
                        <muxc:NavigationViewItem.Icon>
                            <!-- E713 = Setting：标准齿轮（手写多边形路径画不准，用户指出过） -->
                            <FontIcon Glyph="&#xE713;" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </muxc:NavigationView.MenuItems>

                <!-- 底部固定「关于」（决策 D4；方案 A：独立页面，因此有选中态） -->
                <muxc:NavigationView.FooterMenuItems>
                    <muxc:NavigationViewItem
                        x:Name="NavAbout"
                        AutomationProperties.Name="关于 WhalesLauncher"
                        Content="关于"
                        Tag="about">
                        <muxc:NavigationViewItem.Icon>
                            <!-- E946 = Info -->
                            <FontIcon Glyph="&#xE946;" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </muxc:NavigationView.FooterMenuItems>

                <!-- 内容层（规范 §3.3）：Mica 之上铺一层 LayerFillColorDefaultBrush -->
                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Frame x:Name="ContentFrame" />
                </Grid>
            </muxc:NavigationView>
        </muxc:SplitView>

        <!-- 浮层宿主（§9.1 / §9.10.2）：右上角，顶部偏移 = 标题栏 48 + 8；容器不拦截点击 -->
        <controls:ToastHost
            x:Name="ToastLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="0,56,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="False" />
    </Grid>
</Window>
